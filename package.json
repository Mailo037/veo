{
  "name": "@mailo037/veo",
  "version": "1.0.2",
  "description": "A clean, simple video downloader powered by yt-dlp.",
  "type": "module",
  "bin": {
    "veo": "bin/veo.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node scripts/smoke.js",
    "test:open": "node scripts/smoke-open.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "video",
    "downloader",
    "yt-dlp",
    "audio"
  ],
  "license": "MIT",
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  }
}
